# Supabase (필요 시)
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT_REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="..."
SUPABASE_SERVICE_ROLE_KEY="..."

# Prisma / DB
# 앱 실행용: Transaction 모드 (포트 6543)
DATABASE_URL="postgresql://postgres.[PROJECT_REF]:[인코딩된비밀번호]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# 마이그레이션용: Session 모드 (포트 5432) 또는 Direct
DIRECT_URL="postgresql://postgres.[PROJECT_REF]:[인코딩된비밀번호]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres"

# Auth.js
AUTH_SECRET="random" # openssl rand -base64 32 로 생성 권장
AUTH_URL="https://localhost:3000"           # 로컬 개발용