// Looking for ways to speed up your queries, or scale easily with your serverless or edge functions?
// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  //  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// -----------------------------
// Plan (계획)
// -----------------------------
model Plan {
  id               String    @id @default(cuid())
  userId           String
  title            String
  description      String?
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  priority         Int       @default(3)
  successCriteria  String?
  estimatedMinutes Int?
  deletedAt        DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user     User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  versions PlanVersion[]
  todos    Todo[]
  reviews  Review[]

  @@index([userId])
  @@map("plans")
}

// -----------------------------
// PlanVersion (계획 수정 이력) - 고쳐도 이전 내용이 남아야 함
// -----------------------------
model PlanVersion {
  id               String    @id @default(cuid())
  planId           String
  title            String
  description      String?
  startDate        DateTime? @db.Date
  endDate          DateTime? @db.Date
  priority         Int
  successCriteria  String?
  estimatedMinutes Int?
  changedAt        DateTime  @default(now())
  changeNote       String? // 왜 수정했는지 (선택)

  plan Plan @relation(fields: [planId], references: [id], onDelete: Cascade)

  @@index([planId])
  @@map("plan_versions")
}

// -----------------------------
// Todo (할 일)
// -----------------------------
model Todo {
  id               String     @id @default(cuid())
  planId           String
  title            String
  description      String?
  status           TodoStatus @default(PENDING)
  priority         Int        @default(3)
  dueDate          DateTime?  @db.Date
  tags             String[] // PostgreSQL array
  estimatedMinutes Int?
  completedAt      DateTime?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Cascade)
  executionLogs ExecutionLog[]

  @@index([planId])
  @@index([status])
  @@index([dueDate])
  @@map("todos")
}

enum TodoStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

// -----------------------------
// ExecutionLog (실제로 한 일 기록)
// 계획/할 일을 덮어쓰지 않고 별도로 저장
// -----------------------------
model ExecutionLog {
  id            String    @id @default(cuid())
  todoId        String
  startedAt     DateTime
  endedAt       DateTime?
  actualMinutes Int? // 실제로 걸린 시간 (분)
  blockedReason String? // 막혔던 이유
  note          String?
  createdAt     DateTime  @default(now())

  todo Todo @relation(fields: [todoId], references: [id], onDelete: Cascade)

  @@index([todoId])
  @@map("execution_logs")
}

// -----------------------------
// Review (돌아보기 - 고칠 점 등)
// -----------------------------
model Review {
  id          String    @id @default(cuid())
  userId      String
  planId      String?
  periodStart DateTime? @db.Date
  periodEnd   DateTime? @db.Date
  improvement String
  createdAt   DateTime  @default(now())

  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan Plan? @relation(fields: [planId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@map("reviews")
}

model User {
  id            String   @id
  name          String
  email         String   @unique
  emailVerified Boolean  @default(false)
  image         String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  sessions Session[]
  accounts Account[]
  plans    Plan[]
  reviews Review[]

  @@map("user")
}

model Session {
  id        String   @id
  expiresAt DateTime
  token     String   @unique
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  ipAddress String?
  userAgent String?
  userId    String

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id
  accountId             String
  providerId            String
  userId                String
  accessToken           String?
  refreshToken          String?
  idToken               String?
  accessTokenExpiresAt  DateTime?
  refreshTokenExpiresAt DateTime?
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id
  identifier String
  value      String
  expiresAt  DateTime
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([identifier])
  @@map("verification")
}
